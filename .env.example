# Warmline environment configuration
#
# The app works with none of these set: intent interpretation and translation
# fall back to a keyword classifier / marker-stub, and mission calls run in
# mock mode. Set ANTHROPIC_API_KEY or OPENAI_API_KEY alone to get real LLM
# interpretation and translation while still keeping calls mocked. Set all
# four CALL-E variables below (plus an LLM key) to place real phone calls.

# Real LLM interpretation (src/domain/interpret.ts) and translation
# (src/domain/translate.ts). Without either of these, both fall back to their
# stub implementations and the app still builds and runs. If both are set,
# Anthropic is preferred. An OpenAI key pasted into ANTHROPIC_API_KEY by
# mistake also works -- see src/domain/llm.ts for the resolution logic.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to the literal string "true" to allow real CALL-E calls. Also requires
# CALLE_API_KEY and at least one number in CALLE_ALLOWED_NUMBERS below --
# missing any of the three keeps the server in mock mode.
ALLOW_REAL_CALLS=false

# API key for the CALL-E calling provider (@call-e/calle).
CALLE_API_KEY=

# Comma-separated, E.164-formatted allowlist of phone numbers the server is
# permitted to call for real (e.g. +12025550123,+14155550000). This is a
# server-side safety gate independent of what the client submits.
CALLE_ALLOWED_NUMBERS=

# Region passed to CALL-E for real calls. Defaults to "US" if unset.
CALLE_REGION=US
